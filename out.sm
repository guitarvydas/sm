state "idle" {
    {}
    {
        %next "wait for w recrossing" %when (c.x >= c.w) {c.reverse ()}
        %next "wait for zero recrossing" %when (c.x <= 0) {c.reverse ()}
        }
    {}
    }
state "wait for w recrossing" {
    {}
    {
        %next "idle" %when (c.x < c.w)
        }
    {}
    }
state "wait for zero recrossing" {
    {}
    {
        %next "idle" %when (c.x >= 0)
        }
    {}
    }