mr2json {
  Group = name "{" Diagram+ "}"
  Diagram = name "{" dgmid Object+ "}"
  dgmid = "id" "=" str
  attr = ~"kind" name "=" str
  transitionAttr =
    | "kind" "=" "\"" "edge" "\""      -- kind
    | attr                             -- other
  transitionCodeAttr =
    | "kind" "=" "\"" "edgeLabel" "\"" -- kind
    | attr                             -- other
  stateAttr = 
    | "kind" "=" "\"" "ellipse" "\""   -- kind
    | attr                             -- other
  Object =
    | name "{" transitionAttr+ "}"     -- transition
    | name "{" transitionCodeAttr+ "}" -- transitionCode
    | name "{" stateAttr+ "}"          -- state
  name = uletter ualnum*
  uletter = letter | "_"
  ualnum = alnum | "_"
  str = "\"" (~"\"" any)* "\""
}
