state "idle" {
    {}
    {
	    %next "wait for w re-crossing" %if (x > w) {reverse ()}
	    %next "wait for zero re-crossing" %if (x < 0) {reverse ()}
    }
    {}
}
state "wait for w re-crossing" {
    {}
    {
	    %next "idle" %if (x <= w) 
    }
    {}
}
state "wait for zero re-crossing" {
    {}
    {
	    %next "idle" %if (x >= 0) 
    }
    {}
}
