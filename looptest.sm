{
    'idle'
    {}
    {
      if x < 0 {
          %next 'wait for zero recrossing' {reverse ()} }
      elif x > self.width {
          %next 'wait for w recrossing' {reverse ()} }
      else {
          Loop ()}
    }
    {}
}

{
    'wait for zero recrossing'
    {
      Loop ()
    }
    {
      if x >= 0 {
	  Loop ()
	  %next 'idle'}
    }
    {}
}

{
    'wait for w recrossing'
    {
        Loop ()
    }
    {
      if x <= self.width {
	  Loop ()
	  %next 'idle'}
    }
    {}
}



