

def enter_idle ():⤷
pass⤶
def step_idle ():⤷
        %next "wait for w re-crossing" %if (x > w) :⤷reverse ()⤶
        %next "wait for zero re-crossing" %if (x < 0) :⤷reverse ()⤶
        ⤶
def exit_idle ():⤷
pass⤶

def enter_wait_for_w_re-crossing ():⤷
pass⤶
def step_wait_for_w_re-crossing ():⤷
        %next "idle" %if (x <= w)
        ⤶
def exit_wait_for_w_re-crossing ():⤷
pass⤶

def enter_wait_for_zero_re-crossing ():⤷
pass⤶
def step_wait_for_zero_re-crossing ():⤷
        %next "idle" %if (x >= 0)
        ⤶
def exit_wait_for_zero_re-crossing ():⤷
pass⤶

❴:⤷

"idle": idle,
"wait for w re-crossing": wait_for_w_re-crossing,
"wait for zero re-crossing": wait_for_zero_re-crossing,⤶
❵ [self.state] ()

