%parameter diagramid

% rewrite mr2pl {
  Group [name lb Array+ rb] = ‛«Array»’
  
  Diagram [name lb dgmid Object+ rb] =
    ⎡ diagramid=‛«dgmid»’
        ‛«Object»’
    ⎦

  dgmid [name eq str] = ‛ did=«str»,’
  attr [name eq str] = ‛«name»«eq»«str»,’
  transitionAttr_kind [a b c d e] = ‛’
  transitionAttr_other [a] = ‛«a»’
  transitionCodeAttr_kind [a b c d e] = ‛’
  transitionCodeAttr_other [a] = ‛«a»’
  stateAttr_kind [a b c d e] = ‛’
  stateAttr_other [a] = ‛«a»’
  Object_transition [name lb attr+ rb] = ‛\ntransition(⟪diagramid⟫«attr»).’ 
  Object_transitionCode [name lb attr+ rb] = ‛\ntransitionCode(⟪diagramid⟫«attr»).’ 
  Object_state [name lb attr+ rb] = ‛\nstate(⟪diagramid⟫«attr»).’ 
  name [uletter ualnum*] = ‛«uletter»«ualnum»’
  uletter [c] = ‛«c»’
  ualnum [c] = ‛«c»’
  str [lq cs* rq] = ‛«lq»«cs»«rq»’
}
