sm {
  Main = State+
  State = "state" name "{" Enter Step Exit "}"
  Enter = action
  Step = action
  Exit = action
  action =
    | "{}" -- empty
    | "{" #stuff* "}" -- other
  stuff =
    | "{" stuff* "}" -- rec
    | applySyntactic<Next> -- nextStatement
    | ~"{" ~"}" any -- other
  Next =
    | "%next" name "%if" expr transitionCodeEmpty -- empty
    | "%next" name "%if" expr transitionCode      -- code
  name = 
    | "'" (~"'" any)+ "'"    -- squoted
    | "\"" (~"\"" any)+ "\""  -- dquoted
  expr = "(" (~")" any)+ ")"
  transitionCodeEmpty = "{" "}"
  transitionCode = "{" transitionCodeInnards "}"
  transitionCodeInnards =
    | "{" transitionCode* "}" -- rec
    | ~"{" ~"}" any -- other
}
